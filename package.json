{
  "name": "application",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:wrangler": "npm run build && wrangler pages dev .svelte-kit/cloudflare --compatibility-date=2025-09-19 --port 5173 --env-file .env.local",
    "dev:remote": "vite dev --mode development",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:e2e": "playwright test",
    "test": "npm run test:e2e && npm run test:unit -- --run",
    "test:unit": "vitest",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.1",
    "@cloudflare/workers-types": "^4.20251014.0",
    "@eslint/compat": "^1.4.0",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-a11y": "^9.1.13",
    "@storybook/addon-docs": "^9.1.13",
    "@storybook/addon-svelte-csf": "^5.0.10",
    "@storybook/addon-vitest": "^9.1.13",
    "@storybook/sveltekit": "^9.1.13",
    "@sveltejs/adapter-cloudflare": "^7.2.4",
    "@sveltejs/kit": "^2.47.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/vite": "^4.1.15",
    "@types/node": "^24.9.1",
    "@types/pg": "^8.15.5",
    "@vitest/browser": "^3.2.4",
    "daisyui": "^5.3.8",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.5",
    "drizzle-orm": "^0.44.6",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^9.1.13",
    "eslint-plugin-svelte": "^3.12.5",
    "globals": "^16.4.0",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "storybook": "^9.1.13",
    "supabase": "^2.53.6",
    "svelte": "^5.41.2",
    "svelte-check": "^4.3.3",
    "tailwindcss": "^4.1.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.11",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^3.2.4",
    "vitest-browser-svelte": "^1.1.0",
    "wrangler": "^4.44.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.76.1",
    "postgres": "^3.4.7",
    "zod": "^4.1.12"
  }
}
