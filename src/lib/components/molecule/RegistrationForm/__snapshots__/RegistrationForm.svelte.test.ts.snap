exports[`RegistrationForm >  sign in renders correctly with sign in false 1`] = `
"
  

<div class="flex min-h-full flex-col justify-center px-6 py-12 lg:px-8"><div class="sm:mx-auto sm:w-full sm:max-w-sm"><img src="https://tailwindcss.com/plus-assets/img/logos/mark.svg?color=indigo&amp;shade=600" alt="Your Company" class="mx-auto h-10 w-auto dark:hidden"> <img src="https://tailwindcss.com/plus-assets/img/logos/mark.svg?color=indigo&amp;shade=500" alt="Your Company" class="mx-auto h-10 w-auto not-dark:hidden"> <h2 class="mt-10 text-center text-2xl/9 font-bold tracking-tight text-gray-900 dark:text-white"><!---->Regístrate en nuestra plataforma<!----></h2></div> <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-sm"><form class="space-y-6" action="/registrarse" id="registration-form" method="POST"><div><!----><label class="label mb-2" for="email">Correo electrónico</label><!----> <input class="input user-invalid:text-error user-invalid:input-error user-invalid:placeholder:text-error" id="email" type="email" name="email" required="" autocomplete="email" aria-label="Email"> <!----><!----></div> <div><div class="flex items-center justify-between"><label for="password" class="label">Contraseña</label> <!----></div> <div class="mt-2"><!----><!----> <input class="input user-invalid:text-error user-invalid:input-error user-invalid:placeholder:text-error" id="password" type="password" name="password" required="" autocomplete="current-password" aria-label="Password"> <!----><!----></div></div><!----> <div><div class="flex items-center justify-between"><label for="passwordConfirmation" class="label">Confirmar contraseña</label></div> <div class="mt-2"><!----><!----> <input class="input user-invalid:text-error user-invalid:input-error user-invalid:placeholder:text-error" id="passwordConfirmation" type="password" name="passwordConfirmation" required="" autocomplete="current-password" aria-label="Password Confirmation"> <!----><!----></div></div><!----> <div><button type="submit" class="btn w-full btn-primary btn w-full btn-primary" disabled=""><!----><!---->Registrarse<!----></button><!----></div><!----> <!----></form><!----> <p class="mt-10 text-center text-sm/6 text-gray-500 dark:text-gray-400"><!---->¿Ya tienes una cuenta? <a href="/iniciar-sesion" class="link link-primary">Inicia sesión</a><!----></p><!----></div></div>"
`;

exports[`RegistrationForm >  sign in renders correctly with sign in true 1`] = `
"
  

<div class="flex min-h-full flex-col justify-center px-6 py-12 lg:px-8"><div class="sm:mx-auto sm:w-full sm:max-w-sm"><img src="https://tailwindcss.com/plus-assets/img/logos/mark.svg?color=indigo&amp;shade=600" alt="Your Company" class="mx-auto h-10 w-auto dark:hidden"> <img src="https://tailwindcss.com/plus-assets/img/logos/mark.svg?color=indigo&amp;shade=500" alt="Your Company" class="mx-auto h-10 w-auto not-dark:hidden"> <h2 class="mt-10 text-center text-2xl/9 font-bold tracking-tight text-gray-900 dark:text-white">Inicia sesión en tu cuenta<!----></h2></div> <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-sm"><form class="space-y-6" action="/iniciar-sesion" id="login-form" method="POST"><div><!----><label class="label mb-2" for="email">Correo electrónico</label><!----> <input class="input user-invalid:text-error user-invalid:input-error user-invalid:placeholder:text-error" id="email" type="email" name="email" required="" autocomplete="email" aria-label="Email"> <!----><!----></div> <div><div class="flex items-center justify-between"><label for="password" class="label">Contraseña</label> <a href="/recuperar-acceso" class="link link-primary">¿Olvidaste tu contraseña?</a><!----></div> <div class="mt-2"><!----><!----> <input class="input user-invalid:text-error user-invalid:input-error user-invalid:placeholder:text-error" id="password" type="password" name="password" required="" autocomplete="current-password" aria-label="Password"> <!----><!----></div></div><!----> <!----> <div><button type="submit" class="btn w-full btn-primary btn w-full btn-primary" disabled=""><!---->Iniciar sesión<!----></button><!----></div><!----> <!----></form><!----> <p class="mt-10 text-center text-sm/6 text-gray-500 dark:text-gray-400">¿Aún no tienes una cuenta? <a href="/registrarse" class="link link-primary">Regístrate ahora</a><!----></p><!----></div></div>"
`;

exports[`RegistrationForm > renders correctly with resetPassword mode 1`] = `
"
  

<div class="flex min-h-full flex-col justify-center px-6 py-12 lg:px-8"><div class="sm:mx-auto sm:w-full sm:max-w-sm"><img src="https://tailwindcss.com/plus-assets/img/logos/mark.svg?color=indigo&amp;shade=600" alt="Your Company" class="mx-auto h-10 w-auto dark:hidden"> <img src="https://tailwindcss.com/plus-assets/img/logos/mark.svg?color=indigo&amp;shade=500" alt="Your Company" class="mx-auto h-10 w-auto not-dark:hidden"> <h2 class="mt-10 text-center text-2xl/9 font-bold tracking-tight text-gray-900 dark:text-white"><!---->Recupera tu contraseña<!----></h2></div> <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-sm"><form class="space-y-6" action="/recuperar-acceso" id="reset-password-form" method="POST"><div><!----><label class="label mb-2" for="email">Correo electrónico</label><!----> <input class="input user-invalid:text-error user-invalid:input-error user-invalid:placeholder:text-error" id="email" type="email" name="email" required="" autocomplete="email" aria-label="Email"> <!----><!----></div> <!----> <!----> <div><button type="submit" class="btn w-full btn-primary btn w-full btn-primary" disabled=""><!----><!---->Recuperar contraseña<!----></button><!----></div><!----> <!----></form><!----> <!----></div></div>"
